[Unit]
Description=IoT Garage ThingsBoard bridge
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/IoTGarage/runtime
Environment=PYTHONUNBUFFERED=1
Environment=TB_HOST=192.168.1.20
Environment=TB_MQTT_PORT=1884
Environment=TB_GATEWAY_TOKEN=garage-edge-gateway-token
ExecStart=/home/pi/IoTGarage/.venv/bin/python -m tb_bridge --buffer /home/pi/IoTGarage/runtime/tb-buffer.db
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

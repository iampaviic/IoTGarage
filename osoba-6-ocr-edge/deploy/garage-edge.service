# systemd unit for a native (non-Docker) install on Raspberry Pi OS / Ubuntu.
#   sudo cp garage-edge.service garage-tb-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now garage-edge garage-tb-bridge
#   journalctl -u garage-edge -f
[Unit]
Description=IoT Garage edge service (ALPR + access control)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/IoTGarage/runtime
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/IoTGarage/.venv/bin/python -m edge_service --config /home/pi/IoTGarage/osoba-6-ocr-edge/edge.yaml all
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

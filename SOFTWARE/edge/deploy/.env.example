# Local settings of the edge computer. Copy to .env (git-ignored) in this folder:
#   cp .env.example .env
# docker compose reads .env by itself.

# computer running ThingsBoard (SOFTWARE/thingsboard) and its MQTT port
TB_HOST=192.168.1.20
TB_MQTT_PORT=1883

# varijanta B: access token of the device alpr-service (provision.py prints it)
TB_TOKEN_ALPR=alpr-service-token

# varijanta A only: gateway token of the bridge, the same as provision.py --varijanta a --token
TB_GATEWAY_TOKEN=garage-edge-gateway-token

# your copy of edge.example.yaml (create it BEFORE starting, or Docker makes an empty folder)
EDGE_CONFIG=../edge.yaml

# demo = 1 minute billed as 1 hour, real = 15 min free, 1.50 EUR per started hour
PRICING_PROFILE=demo

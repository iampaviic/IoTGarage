# Varijanta B: systemd unit for the ALPR service (native install, Raspberry Pi OS / Ubuntu).
# ThingsBoard address and access token: section `thingsboard` in edge.yaml.
#   sudo cp garage-alpr.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now garage-alpr
#   journalctl -u garage-alpr -f
[Unit]
Description=IoT Garage ALPR service (ThingsBoard device alpr-service)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/IoTGarage/SOFTWARE/runtime
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/IoTGarage/SOFTWARE/.venv/bin/python -m edge_service --config /home/pi/IoTGarage/SOFTWARE/edge/edge.yaml tb-alpr
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
